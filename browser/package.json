{
  "name": "orz-mdhtml-browser",
  "version": "0.9.3",
  "description": "The orz-mdhtml browser engine and editor component (FC-19): globalThis.OrzCarrier (IIFE) or ES module exports — mountEditor, assemble, extract, readDocument, renderPreview. Served via jsDelivr for .md.html files; embeddable in web apps.",
  "main": "orz-mdhtml.browser.js",
  "module": "esm/orz-mdhtml.browser.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./esm/orz-mdhtml.browser.mjs",
      "default": "./orz-mdhtml.browser.js"
    },
    "./orz-mdhtml.browser.js": "./orz-mdhtml.browser.js",
    "./esm": {
      "types": "./index.d.ts",
      "default": "./esm/orz-mdhtml.browser.mjs"
    },
    "./release.json": "./release.json",
    "./package.json": "./package.json"
  },
  "files": [
    "orz-mdhtml.browser.js",
    "esm/orz-mdhtml.browser.mjs",
    "index.d.ts",
    "release.json",
    "README.md"
  ],
  "keywords": [
    "orz-markdown",
    "orz-mdhtml",
    "markdown",
    "editor",
    "browser",
    "cdn"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-mdhtml.git"
  },
  "homepage": "https://markdown.orz.how/family.html#mdhtml",
  "bugs": "https://github.com/wangyu16/orz-mdhtml/issues",
  "publishConfig": {
    "access": "public"
  }
}
