{
  "name": "orz-mdhtml",
  "version": "0.9.3",
  "description": "Generate single-file, self-editing .md.html documents from Markdown with live preview, source-aware copy, and in-place save.",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "orz-mdhtml": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "orz-mdhtml-skills",
    "PROTOCOL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle",
    "prebuild": "tsx scripts/sync-version.ts",
    "bundle": "tsx build/bundle.ts",
    "test": "vitest run",
    "pretest": "tsx scripts/sync-version.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen": "tsx src/cli.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "markdown",
    "orz-markdown",
    "self-contained",
    "html",
    "editor",
    "single-file"
  ],
  "author": "Yu Wang <yuwang@orz.how>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyu16/orz-mdhtml.git"
  },
  "homepage": "https://markdown.orz.how/family.html#mdhtml",
  "bugs": "https://github.com/wangyu16/orz-mdhtml/issues",
  "dependencies": {
    "orz-markdown": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.16"
  }
}
